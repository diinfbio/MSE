% This dataset contain attributes of dresses and their recommendations according to their sales. Sales are monitor on the basis of alternate days.The attributes present analyzed are: Recommendation, Style, Price, Rating, Size, Season, NeckLine, SleeveLength, waiseline, Material, FabricType, Decoration, Pattern, Type. In this dataset they are named Class(target) and then subsequently V2 - V13.Contact:Muhammad Usman & Adeel Ahmed, usman.madspot '@' gmail.com adeel.ahmed92 '@' gmail.com, Air University, Students at Air University.
@RELATION dresses-sales

@ATTRIBUTE V4 REAL
@ATTRIBUTE V2 {Brief, Casual, Flare, Novelty, OL, Sexy, bohemian, cute, fashion, party, sexy, vintage, work}
@ATTRIBUTE V3 {Average, High, Low, Medium, high, low, nan, very-high}
@ATTRIBUTE V5 {L, M, S, XL, free, s, small}
@ATTRIBUTE V6 {Automn, Autumn, Spring, Summer, Winter, nan, spring, summer, winter}
@ATTRIBUTE V7 {Scoop, Sweetheart, backless, boat-neck, bowneck, halter, mandarin-collor, nan, o-neck, open, peterpan-collor, ruffled, slash-neck, sqare-collor, sweetheart, turndowncollor, v-neck}
@ATTRIBUTE V8 {Petal, butterfly, cap-sleeves, capsleeves, full, half, halfsleeve, nan, short, sleeevless, sleeveless, sleevless, sleveless, threequarter, threequater, thressqatar, turndowncollor, urndowncollor}
@ATTRIBUTE V9 {dropped, empire, nan, natural, princess}
@ATTRIBUTE V10 {acrylic, cashmere, chiffonfabric, cotton, knitting, lace, linen, lycra, microfiber, milksilk, mix, modal, model, nan, nylon, other, polyster, rayon, shiffon, silk, sill, spandex, viscos, wool}
@ATTRIBUTE V11 {Corduroy, batik, broadcloth, chiffon, dobby, flannael, flannel, jersey, knitted, knitting, lace, nan, organza, other, poplin, satin, sattin, shiffon, terry, tulle, wollen, woolen, worsted}
@ATTRIBUTE V12 {Tiered, applique, beading, bow, button, cascading, crystal, draped, embroidary, feathers, flowers, hollowout, lace, nan, none, pearls, plain, pleat, pockets, rivet, ruched, ruffles, sashes, sequined, tassel}
@ATTRIBUTE V13 {animal, character, dot, floral, geometric, leapord, leopard, nan, none, patchwork, plaid, print, solid, splice, striped}
@ATTRIBUTE class INTEGER

